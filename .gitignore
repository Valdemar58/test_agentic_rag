# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# Секреты и локальная конфигурация
.env

# Данные никогда не коммитятся: экспорт СЭД, примеры карточек, файлы документов,
# архивы, кэши и веса моделей (§9 ТЗ, решение заказчика 2026-09-14)
data/
card_response_example.json
*.zip
*.tar
models/
hf_cache/

# Собранные образы и артефакты для передачи заказчику
dist/
selftest_output/
# Результаты реального экспорта от заказчика (отчёт содержит номера и темы документов)
artifacts/

# Логи и служебные каталоги инструментов
*.log
# Chainlit: в репозитории только настройки и русский перевод; остальные переводы и загрузки — нет
.chainlit/*
!.chainlit/config.toml
!.chainlit/translations/
.chainlit/translations/*
!.chainlit/translations/ru-RU.json
.files/
.langfuse/
.claude/

# Голден-сет по реальному корпусу: вопросы, эталоны и ID документов заказчика (пример формата — eval/golden_set.example.yaml)
eval/golden_set.yaml
# Отчёты eval-harness: содержат вопросы, ответы и тексты фрагментов реальных документов
eval/reports/
