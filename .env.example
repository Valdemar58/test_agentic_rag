# Скопируйте в .env и заполните. Файл .env не коммитится.

# Пути к внешнему коду (в репозиторий не копируется, §8.0 ТЗ).
# Без них тесты с маркером contract скипаются.
TESSA_SDK_PATH=/path/to/tessa_sdk
CARD_SERVICE_PATH=/path/to/robot_skills

# Сервис карточек: мок в dev, реальный сервис заказчика в проде. Переключение — один URL.
CARD_SERVICE_URL=http://localhost:8010
CARD_SERVICE_USERNAME=
CARD_SERVICE_PASSWORD=
